#!/usr/bin/env bash
# The AppImage's entry point. appimagetool runs this in place of the
# executable named in the desktop file, with the mounted (or extracted)
# AppDir as the working directory.
#
# Everything here exists to answer one question: once cordial-shell is moved
# off the machine it was built on, how does it find the things it needs that
# are not DT_NEEDED entries and so were not swept up by linuxdeploy's
# dependency walk in build-appimage.sh? Each export below is one such thing.
set -euo pipefail

APPDIR="${APPDIR:-$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"

# Bundled libraries ahead of the host's own. The whole reason this AppImage
# exists rather than a bare tarball of the two binaries is that the host's
# gtk4/libadwaita is routinely older than what this workspace builds and
# tests against -- Fedora 43 ships gtk4 4.20.3 and libadwaita 1.8.3 against
# the 4.22/1.9 test.yml pins, and the failure mode for an ordinary build
# against an old system library is three *-sys build scripts refusing to
# configure. An AppImage sidesteps that only if it actually carries its own
# copies rather than linking the host's, which is what this line is for.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH:-}"

# GSettings schemas are found by path lookup through GIO, not through a
# symbol linuxdeploy's ELF dependency walk can see -- nothing in
# cordial-shell references the schema directory by name, so nothing about it
# survives an ordinary --executable bundling pass. build-appimage.sh compiles
# a copy into usr/share/glib-2.0/schemas for exactly this reason.
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"

export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# WebKitGTK does not link its helper processes into cordial-run; it spawns
# WebKitWebProcess and WebKitNetworkProcess as separate executables read from
# a compiled-in /usr/libexec/webkitgtk-6.0 path, which is the same kind of gap
# GSettings has above -- nothing DT_NEEDED can find because nothing links it.
# build-appimage.sh copies that whole directory to usr/libexec/webkitgtk-6.0
# and this is WebKitGTK's own override for where to look instead of the
# compiled-in path.
#
# This was INFERRED and it is wrong. Measured 2026-08-27 against the
# webkitgtk6.0-2.52.5 this bundles, on Fedora 44:
#
#   - The string WEBKIT_EXEC_PATH does not occur anywhere in
#     libwebkitgtk-6.0.so.4, libjavascriptcoregtk-6.0.so.1, or the three
#     helper binaries. Thirty-odd other WEBKIT_* variable names do, including
#     WEBKIT_INJECTED_BUNDLE_PATH, so this is not an artefact of how the
#     strings were read. Upstream gates the lookup on ENABLE(DEVELOPER_MODE)
#     and distributions build with it off -- INFERRED, but it fits.
#   - With this variable exported at exactly this path, MiniBrowser out of the
#     built AppDir spawned /usr/libexec/webkitgtk-6.0/WebKitWebProcess: the
#     *host's* binary, read straight off readlink /proc/PID/exe. It then
#     loaded the AppImage's own libwebkitgtk into the host's executable, which
#     is only survivable because both are 2.52.5 here.
#   - Replace that host directory with an empty tmpfs under bwrap -- which is
#     what a machine that never installed webkitgtk6.0 looks like -- and the
#     same run aborts in under a tenth of a second with `Failed to spawn child
#     process "/usr/libexec/webkitgtk-6.0/WebKitNetworkProcess" (No such file
#     or directory)`. The control, the identical bwrap namespace with the
#     directory still visible, ran for the full 25 s without complaint.
#
# So the export below is inert and the AppImage's web view works only on hosts
# that already have WebKitGTK 6.0 installed at the distribution's own path.
# **The symptom on a host without it is a blank sign-in window** -- the shell
# starts, draws, and opens a web view with nothing in it, because the process
# that would have rendered the page could not be spawned. Whether cordial-shell
# survives that or dies the way MiniBrowser did above is not established; the
# probe was MiniBrowser, not the shell. Either way: do not read a blank sign-in
# as a Roblox problem, a network problem, or the URL policy refusing something.
# Two more absolute paths are compiled into that library the same way and are
# not bundled either: /usr/bin/bwrap and /usr/bin/xdg-dbus-proxy for its
# sandbox, and the injected bundle, which the probe above loaded from
# /usr/lib64/webkitgtk-6.0/injected-bundle. WEBKIT_INJECTED_BUNDLE_PATH would
# move the last of those; nothing moves the first two.
#
# It is kept rather than deleted because it costs nothing, it is what any real
# fix would have to redirect, and a deleted line takes the finding with it. A
# real fix is a mount namespace over /usr/libexec/webkitgtk-6.0, or a WebKit
# built for this, and neither has been tried here.
export WEBKIT_EXEC_PATH="${APPDIR}/usr/libexec/webkitgtk-6.0"

exec "${APPDIR}/usr/bin/cordial-shell" "$@"
