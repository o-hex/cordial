+  soinfo* si = soinfo_from_handle(handle);
+  if (si == nullptr) {
+    return 0;
+  }
+  *machine = si->guest_machine_;
+  *init_func = reinterpret_cast<void*>(si->init_func_);
+  *init_array = reinterpret_cast<void**>(si->init_array_);
