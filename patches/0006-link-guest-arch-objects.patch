+// Relative relocations RELR encodes, counted the way `relocate_relr` applies
+// them: one per even word, one per set bit above bit 0 of an odd one.
+static size_t count_relr(const ElfW(Relr)* relr, size_t n) {
+  size_t count = 0;
+  for (size_t i = 0; i < n; ++i) {
+    count += (relr[i] & 1) == 0 ? 1 : __builtin_popcountll(relr[i] >> 1);
+  }
+  return count;
+}
