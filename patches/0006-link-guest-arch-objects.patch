+  {R_AARCH64_ABS64, R_GENERIC_ABSOLUTE, "R_AARCH64_ABS64"},
+  {R_AARCH64_GLOB_DAT, R_GENERIC_GLOB_DAT, "R_AARCH64_GLOB_DAT"},
+  {R_AARCH64_JUMP_SLOT, R_GENERIC_JUMP_SLOT, "R_AARCH64_JUMP_SLOT"},
