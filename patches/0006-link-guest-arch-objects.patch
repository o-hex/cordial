+static bool process_guest_relocation(Relocator& relocator, const rel_t& reloc) {
+  const uint32_t r_type = ELFW(R_TYPE)(reloc.r_info);
+  if (relocator.si->guest_machine_ != EM_AARCH64) {
+    DL_ERR("\"%s\" is a guest object for machine %d, and only EM_AARCH64 guests are supported",
+           relocator.si->get_realpath(), relocator.si->guest_machine_);
