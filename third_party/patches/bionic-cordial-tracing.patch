+// Cordial addition, not upstream: docs/analysis/flag-init.md §31 asks whether
+// the engine locates its own private data directory by walking up from its
+// own library path, the way an Android app finds /data/user/0/<pkg> from
+// /data/app/<pkg>/lib/<abi>/. dladdr() and dl_iterate_phdr() are the two ways
+// guest code can ask the linker "where am I" (the third, /proc/self/maps, is
+// a plain file read and already visible in CORDIAL_TRACE_PATHS=1 -- and never
+// appears there). Tracing which of these two the engine actually calls, and
+// with what result, answers the question by observation instead of by
+// picking one to patch and hoping.
 __attribute__((__weak__))
 int dladdr(const void* addr, Dl_info* info) {
-  return __loader_dladdr(addr, info);
+  static const bool trace = getenv("CORDIAL_TRACE_DLADDR") != nullptr;
+  int r = __loader_dladdr(addr, info);
+  if (trace) {
+    fprintf(stderr, "[cordial-dladdr-trace] dladdr(%p) -> %d fname=%s fbase=%p\n", addr, r,
+            (r && info && info->dli_fname) ? info->dli_fname : "(null)",
+            (r && info) ? info->dli_fbase : nullptr);
+  }
+  return r;
 }
 
