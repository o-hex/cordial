+// EXPERIMENTAL, cordial-agent-defer: whether the next do_dlopen() should map
+// and relocate a library without running its ELF constructors, leaving the
+// caller to call mcpelauncher_run_deferred_ctors() explicitly once it is
+// ready. See docs/analysis/flag-init.md §26 for why: RbxStorage::init runs
+// during libroblox.so's own constructors, before Cordial has told the engine
+// its directories, and memoises a failure nothing later can undo. This flag
+// exists to test whether deferring construction past that setup is coherent
+// at the linker level; it is not wired into the default load path.
+static bool g_defer_next_ctors = false;
+
+soinfo* soinfo_from_handle(void* handle);
+
+extern "C" void mcpelauncher_defer_next_ctors(int defer) {
+  g_defer_next_ctors = defer != 0;
+}
+
+// Runs whatever construction a prior do_dlopen() left pending because
+// g_defer_next_ctors was set. A no-op if constructors already ran (call_
+// constructors() is itself idempotent via soinfo::constructors_called), so
+// calling this on a handle that was never deferred is harmless.
+extern "C" void mcpelauncher_run_deferred_ctors(void* handle) {
+  soinfo* si = soinfo_from_handle(handle);
+  if (si != nullptr) {
+    si->call_constructors();
+  }
+}
+
+// Cordial addition, not upstream: overrides a loaded library's realpath_ as
+// pure metadata -- nothing is reopened or remapped, and every byte already
+// mapped stays exactly where it was. Meant to be called between deferring a
+// library's constructors and running them (see mcpelauncher_defer_next_ctors
+// above), so the override is in place before any constructor-time code that
+// asks the linker "what is my own path".
+//
+// Exists to test docs/analysis/flag-init.md §31/§30: a root-privileged text
+// compare showed Sober's engine mapped from an authentic Android install
+// path (/data/app/~~<hash>/com.roblox.client-<hash>/lib/x86_64/libroblox.so)
+// with zero altered bytes, while Cordial maps the identical engine from
+// ~/.cache/cordial/lib/x86_64/libroblox.so -- nothing shaped like a package
+// layout. do_dladdr() below answers a self-lookup with exactly this field
+// (si->get_realpath()), which is the one piece of "where am I" the engine can
+// reach before JNI_OnLoad has even run, since RbxStorage::init's failing
+// stat("") calls happen during ELF construction, strictly before that.
+extern "C" void mcpelauncher_set_realpath(void* handle, const char* path) {
+  soinfo* si = soinfo_from_handle(handle);
+  if (si != nullptr && path != nullptr) {
+    si->set_realpath(path);
+  }
+}
+
