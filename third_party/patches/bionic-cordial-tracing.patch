     void* handle = si->to_handle();
-    LD_LOG(kLogDlopen,
-           "... dlopen calling constructors: realpath=\"%s\", soname=\"%s\", handle=%p",
-           si->get_realpath(), si->get_soname(), handle);
-    si->call_constructors();
+    if (g_defer_next_ctors) {
+      g_defer_next_ctors = false;
+      LD_LOG(kLogDlopen,
+             "... dlopen DEFERRING constructors (cordial-agent-defer): realpath=\"%s\", soname=\"%s\", handle=%p",
+             si->get_realpath(), si->get_soname(), handle);
+    } else {
+      LD_LOG(kLogDlopen,
+             "... dlopen calling constructors: realpath=\"%s\", soname=\"%s\", handle=%p",
+             si->get_realpath(), si->get_soname(), handle);
+      si->call_constructors();
